// Datenmodell Gartenbegehungs-App — siehe Spec/CLAUDE.md.
// KISS: Dateien im Dateisystem, SQLite. Logins: Vorstand-Modell (E-Mail +
// scrypt-Hash, via /einstellungen) mit APP_USERS-Env-Fallback.
// Hinweis: SQLite kennt keine nativen Enums -> Auswahl-Felder sind String mit
// dokumentierten erlaubten Werten. EINZIGE Quelle der Wahrheit für erlaubte Werte:
// src/lib/constants.ts (beim App-Bau anlegen) — Schema-Kommentare spiegeln sie nur.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Anlage {
  id        Int      @id @default(autoincrement())
  kuerzel   String   @unique // "K", "S"
  name      String // "Kühwasen", "Silberwald"
  planBild  String? // Pfad zum Plan-Bild (statisch)
  parzellen Parzelle[]
  runden    Begehungsrunde[]
}

model Parzelle {
  id         Int    @id @default(autoincrement())
  parzelleId String @unique // "K1", "S59a" (Kürzel+Nummer+Index)
  anlage     Anlage @relation(fields: [anlageId], references: [id])
  anlageId   Int
  nummer     Int // numerisch -> stabile Sortierung für Vor/Zurück-Navigation
  index      String @default("") // "", "a", ...
  // Pächter-Stammdaten (liegen auf der Parzelle — kein separates CRM)
  nachname   String @default("")
  vorname    String @default("")
  email      String @default("")
  telefon    String @default("")
  strasse    String @default("")
  plz        String @default("")
  ort        String @default("")
  eintritt   String @default("") // ISO-Datum als Text (Import-tolerant)
  groesseM2  Int? // Parzellenfläche
  // erlaubt: verpachtet | neupaechter | gekuendigt | nicht_verpachtet
  status     String @default("verpachtet")

  befunde     Befund[]
  dokumente   Dokument[]
  archivFotos ArchivFoto[]
  aenderungen ParzelleAenderung[]

  @@index([anlageId])
}

// Schlüssel-Ereignisse je Parzelle (Pächterwechsel, Umzug, Kontakt-/Statusänderung …)
// mit Datum — Verwaltungs-Historie.
model ParzelleAenderung {
  id         Int      @id @default(autoincrement())
  parzelle   Parzelle @relation(fields: [parzelleId], references: [id], onDelete: Cascade)
  parzelleId Int
  datum      DateTime @default(now())
  // erlaubt: paechterwechsel | umzug | kontakt | status | stammdaten | sonstiges
  art        String   @default("sonstiges")
  notiz      String   @default("")
  erstelltAm DateTime @default(now())

  @@index([parzelleId, datum])
}

model Begehungsrunde {
  id           Int      @id @default(autoincrement())
  anlage       Anlage   @relation(fields: [anlageId], references: [id])
  anlageId     Int
  datum        DateTime
  bezeichnung  String // "Begehung 17.05.2026 – Silberwald"
  // erlaubt: begehung | nachbegehung (Nachverfolgung offener Mängel)
  art          String   @default("begehung")
  teilnehmende String   @default("")
  // erlaubt: offen | abgeschlossen — abgeschlossen => Befunde eingefroren
  status       String   @default("offen")
  // Zeitpunkt des Abschlusses: offline gepufferte Medien/Diktate werden noch
  // 48 h danach angenommen (Gnadenfrist — Daten entstanden während der Runde).
  abgeschlossenAm DateTime?
  erstelltAm   DateTime @default(now())

  befunde Befund[]

  @@index([anlageId, datum])
}

model Befund {
  id         Int            @id @default(autoincrement())
  runde      Begehungsrunde @relation(fields: [rundeId], references: [id], onDelete: Cascade)
  rundeId    Int
  parzelle   Parzelle       @relation(fields: [parzelleId], references: [id]) // kein Cascade: Parzelle mit Historie nicht löschbar
  parzelleId Int
  // Eskalation (GO §13.2 / UPV §4) — gilt pro Parzelle/Runde (= ein Schreiben je Parzelle)
  // erlaubt: neutral | ok | gespraech | mitteilung | abmahnung_1 | abmahnung_2 | kuendigung
  stufe      String         @default("neutral")
  // Nachbearbeitungs-Status (Schreibtisch, NICHT Teil der Offline-Erfassung/des Sync).
  // erlaubt: offen | muendlich | hinweis_versendet | abmahnung_versendet |
  //          abmahnung_bv | kuendigung_paechter | kuendigung_bv
  status     String         @default("offen")
  notiz      String         @default("") // allgemeine Bemerkung / Zustand
  // Offline nachgereichte Diktate (transkribiert nach Sync): append-only, wird vom
  // Befund-Speichern NIE überschrieben (kein Clobber) -> read-only auf der Seite.
  diktatNachgereicht String  @default("")
  zeitpunkt  DateTime       @default(now())

  // Snapshot zum Begehungszeitpunkt — eingefroren für rechtssichere Doku über Jahre
  snapParzelleId String
  snapPaechter   String @default("")
  snapAdresse    String @default("")

  // "Gut gemacht"-Plakette (KISS: Felder am Befund statt eigenem Modell)
  gutGemacht     Boolean @default(false)
  plakettenNotiz String  @default("")

  // Kompensation geringer Gemüsefläche durch sonstigen Anbau (Obst/Beerenobst);
  // dokumentiert ausreichende kleingärtnerische Nutzung (Anbau gesamt >= 1/3).
  kompensationFaktoren    String  @default("") // veraltet (durch Anzahl/Fläche ersetzt)
  kompObstAnzahl          Int     @default(0)
  kompObstFlaecheM2       Float   @default(0)
  kompBeerenAnzahl        Int     @default(0)
  kompBeerenFlaecheM2     Float   @default(0)
  kompensationNotiz       String  @default("")
  kompensationAusreichend Boolean @default(false)

  beete   Beet[]
  maengel Mangel[]
  fotos   Foto[]

  @@unique([rundeId, parzelleId])
  @@index([parzelleId])
}

// Gemüsebeete (bis zu 5 — Grenze in der UI) — IST-Fläche, Summe vs. SOLL (1/6 der Parzelle)
model Beet {
  id          Int    @id @default(autoincrement())
  // Client-UUID (Offline-Sync) — siehe Mangel.uid.
  uid         String? @unique @default(uuid())
  befund      Befund @relation(fields: [befundId], references: [id], onDelete: Cascade)
  befundId    Int
  bezeichnung String @default("")
  flaecheM2   Float  @default(0)
  fotos       Foto[]
}

model Mangel {
  id        Int      @id @default(autoincrement())
  // Client-UUID (Offline-Sync): Idempotenzschlüssel für Op-Upserts + Referenz
  // für gepufferte Fotos/Diktate. Nullable-unique (Altzeilen per Backfill gefüllt).
  uid       String?  @unique @default(uuid())
  befund    Befund   @relation(fields: [befundId], references: [id], onDelete: Cascade)
  befundId  Int
  katalog   Katalog? @relation(fields: [katalogId], references: [id]) // SetNull: Katalogpunkt entfällt -> Freitext bleibt
  katalogId Int?
  bereich   String // Snapshot des Katalog-Bereichs (eingefroren)
  punkt     String // Snapshot des Katalog-Punkts (oder Freitext)
  notiz     String   @default("")
  // erlaubt: offen | behoben
  status    String   @default("offen")
  frist     DateTime?
  behobenAm DateTime? // beim Umschalten auf "behoben" gesetzt — Ursprungsstand bleibt erhalten
  // Offline nachgereichte Diktate (transkribiert nach Sync): append-only, wird vom
  // Mangel-Speichern NIE überschrieben (kein Clobber) -> read-only auf der Seite.
  diktatNachgereicht String @default("")
  fotos     Foto[]

  @@index([befundId])
  @@index([status])
}

model Foto {
  id           Int      @id @default(autoincrement())
  befund       Befund   @relation(fields: [befundId], references: [id], onDelete: Cascade)
  befundId     Int
  mangel       Mangel?  @relation(fields: [mangelId], references: [id], onDelete: Cascade)
  mangelId     Int?
  beet         Beet?    @relation(fields: [beetId], references: [id], onDelete: Cascade)
  beetId       Int?
  // erlaubt: mangel | zustand | beet
  kontext      String   @default("mangel")
  dateipfad    String // relativ zu STORAGE_DIR; beim Upload: resize ~1600px + EXIF/Geo-Strip
  beschreibung String   @default("")
  erstelltAm   DateTime @default(now())

  @@index([befundId])
}

// Akte je Parzelle: Schreiben, E-Mails, Wertermittlungen (PDF) + Fotos
model Dokument {
  id         Int      @id @default(autoincrement())
  parzelle   Parzelle @relation(fields: [parzelleId], references: [id], onDelete: Cascade)
  parzelleId Int
  // erlaubt: schreiben | email | wertermittlung | sonstiges
  typ        String   @default("sonstiges")
  dateipfad  String // relativ zu STORAGE_DIR
  datum      DateTime @default(now())
  notiz      String   @default("")

  @@index([parzelleId])
}

// Archiv-Fotos früherer Begehungen (nicht an eine Runde/Befund gebunden).
// Gruppiert je Parzelle nach Begehungsdatum in der Akte.
model ArchivFoto {
  id         Int      @id @default(autoincrement())
  parzelle   Parzelle @relation(fields: [parzelleId], references: [id], onDelete: Cascade)
  parzelleId Int
  datum      DateTime // Begehungsdatum (für Gruppierung "Fotos 17.03.2022")
  quelle     String   @default("") // Herkunft/Ordnername, z. B. "Begehung 29.06.2023"
  dateipfad  String // relativ zu STORAGE_DIR (verarbeitetes JPEG)
  erstelltAm DateTime @default(now())

  @@index([parzelleId, datum])
}

// Vorstandsmitglieder: Teilnehmerliste für Begehungen + optionale Logins
// (E-Mail + Passwort gesetzt => Anmeldung möglich). Pflege via /einstellungen.
// Deaktivieren statt löschen — Namen stehen in alten teilnehmende-Strings.
model Vorstand {
  id           Int     @id @default(autoincrement())
  name         String  @unique
  email        String? @unique // klein geschrieben gespeichert (Login lowercased)
  passwortHash String? // scrypt, hex — siehe src/lib/passwort.ts
  passwortSalt String? // hex
  aktiv        Boolean @default(true)
  sortierung   Int     @default(0) // Vereinsnummerierung
}

// Mängelkatalog als Daten (anpassbar) — aus dem Vereins-Formular
model Katalog {
  id         Int      @id @default(autoincrement())
  bereich    String // "Garten", "Baulichkeiten und Nebenanlagen", "Sonstiges"
  punkt      String
  hinweis    String   @default("") // optionale Sub-Checkboxen / Maße als Hilfetext
  referenz   String   @default("") // "UPV §4 / GO 1.3"
  sortierung Int      @default(0)
  aktiv      Boolean  @default(true)
  maengel    Mangel[]
}
